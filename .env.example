# Redis
REDIS_URI=redis://your-redis-url

# MongoDB Configuration
MONGO_BD_IN_USE=atlas
MONGO_ATLAS_URI=mongodb+srv://user:password@cluster.mongodb.net/database

# Database Selection
BASE_IN_USE=mongo

# JWT Secret
JWT_SECRET=your-jwt-secret-key

# Vercel Environment Variables (set these in Vercel dashboard)
# MONGODB_CONNECTION_STRING=mongodb+srv://user:password@cluster.mongodb.net/database
# MONGODB_DATABASE_NAME=your-database-name